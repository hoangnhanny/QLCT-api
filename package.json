{
  "name": "qlct",
  "version": "0.0.1",
  "private": true,
  "description": "QLCT - Vietnamese family expense tracker PWA monorepo",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "yarn workspace api start:dev",
    "dev:web": "yarn workspace web dev",
    "build": "yarn workspaces run build",
    "type-check": "yarn workspaces run type-check",
    "lint": "yarn workspaces run lint",
    "test": "yarn workspaces run test",
    "test:e2e": "yarn workspace api test:e2e",
    "health-check": "bash scripts/test-supabase.sh",
    "ci": "yarn lint && yarn type-check && yarn build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
